        "publicDir": "public"
      },
      "assets": {
        "basePath": "/assets/context7",
        "include": ["data/site/**", "public/**"]
      },
      "routes": {
        "baseUrl": "/",
        "rewrites": []
      },
      "secrets": {
        "envFile": ".env.local"
      }
    }
  },
  "metadata": {
    "createdBy": "opencode",
    "createdAt": "2026-08-06T00:00:00.000Z"
  }
